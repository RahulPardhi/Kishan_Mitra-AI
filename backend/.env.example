# Server Configuration
PORT=5000

# MongoDB Database URI
# Local: mongodb://127.0.0.1:27017/kisanmitra
# Cloud (Render/Production): Use a MongoDB Atlas URI like:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kisanmitra?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/kisanmitra

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key (AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
